//! Tests: each operation on known values, layouts and reflection, and
//! properties over random inputs (inverse times matrix is the identity,
//! a quaternion rotates as its matrix does, Euler angles round-trip in
//! every order, projections map near and far to the depth range).

mod affine;
mod euler;
mod example;
mod layout;
mod mat;
#[cfg(feature = "nabion")]
mod nabion;
mod property;
mod quat;
mod shape;
mod transform;
mod vec;

use pkg::{DQuat, DVec3, Quat, Vec3};
use std::random::{Rng, Xoshiro256PlusPlus};

/// Panic with `what` unless `ok`.
pub fn expect(ok: bool, what: str) {
    if !ok { panic(f"check failed: {what}"); }
}

/// Panic unless `|a - b| <= tol`.
pub fn close(a: f64, b: f64, tol: f64, what: str) {
    if !((a - b).abs() <= tol) { panic(f"{what}: {a} != {b} (tol {tol})"); }
}

/// A seeded generator, so a failure repeats.
pub fn rng(seed: u64) -> Xoshiro256PlusPlus { Xoshiro256PlusPlus::seed(seed) }

/// A vector with components in `-r..r`.
pub fn dvec3(ref g: Xoshiro256PlusPlus, r: f64) -> DVec3 {
    DVec3::new(g.uniform(-r, r), g.uniform(-r, r), g.uniform(-r, r))
}

/// A random unit vector.
pub fn dunit(ref g: Xoshiro256PlusPlus) -> DVec3 {
    loop {
        let v = dvec3(ref g, 1.0);
        let l = v.length_squared();
        if l > 1e-3 && l <= 1.0 { return v.normalize(); }
    }
}

/// A random rotation.
pub fn dquat(ref g: Xoshiro256PlusPlus) -> DQuat {
    DQuat::from_axis_angle(dunit(ref g), g.uniform(-3.1, 3.1))
}

/// `v` as `f32`.
pub fn narrow(v: DVec3) -> Vec3 { Vec3::new(v.x as f32, v.y as f32, v.z as f32) }

/// `q` as `f32`.
pub fn narrowq(q: DQuat) -> Quat { Quat::from_xyzw(q.x as f32, q.y as f32, q.z as f32, q.w as f32) }
