// Affine transforms against the matrices they stand for.

use pkg::tests::suite::expect;
use pkg::{DAffine2, DAffine3, DMat3, DMat4, DQuat, DVec2, DVec3};

#[test]
fn affine2() {
    let a = DAffine2::from_scale_angle_translation(DVec2::new(2.0, 3.0), 0.6, DVec2::new(-1.0, 4.0));
    let m = a.to_mat3();
    let p = DVec2::new(0.5, -2.0);
    expect(a.transform_point(p).approx_eq(m.transform_point2(p), 1e-12), "point as mat3");
    expect(a.transform_vector(p).approx_eq(m.transform_vector2(p), 1e-12), "vector as mat3");
    expect(DAffine2::from_mat3(m).approx_eq(a, 1e-12), "mat3 round trip");
    expect((a * a.inverse()).approx_eq(DAffine2::identity(), 1e-12), "inverse");
    let b = DAffine2::from_angle(1.0) * DAffine2::from_translation(DVec2::X);
    expect(b.transform_point(DVec2::ZERO).approx_eq(DVec2::from_angle(1.0), 1e-12), "b first");
    expect(DAffine2::from_scale(DVec2::splat(2.0)).transform_point(DVec2::ONE) == DVec2::splat(2.0), "scale");
}

#[test]
fn affine3() {
    let a = DAffine3::from_scale_rotation_translation(DVec3::new(1.0, 2.0, 0.5), DQuat::from_rotation_x(0.9), DVec3::new(3.0, 0.0, -1.0));
    let m = a.to_mat4();
    let p = DVec3::new(1.0, -1.0, 2.0);
    expect(a.transform_point(p).approx_eq(m.transform_point(p), 1e-12), "point as mat4");
    expect(a.transform_vector(p).approx_eq(m.transform_vector(p), 1e-12), "vector as mat4");
    expect(DAffine3::from_mat4(m).approx_eq(a, 1e-12), "mat4 round trip");
    expect(a.inverse().to_mat4().approx_eq(m.inverse(), 1e-12), "inverse as mat4");
    let b = DAffine3::from_quat(DQuat::from_rotation_y(0.3));
    expect((a * b).to_mat4().approx_eq(m * b.to_mat4(), 1e-12), "product as mat4");
    expect(DAffine3::from_axis_angle(DVec3::Z, 0.2).matrix == DMat3::from_axis_angle(DVec3::Z, 0.2), "axis angle");
    expect(DAffine3::from_scale(DVec3::ONE).to_mat4() == DMat4::IDENTITY, "unit scale");
}
