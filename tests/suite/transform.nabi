// Transform against its matrix.

use pkg::tests::suite::expect;
use pkg::{DQuat, DTransform, DVec3, Transform, Vec3};

#[test]
fn matches_matrix() {
    let t = DTransform::new(DVec3::new(1.0, 2.0, 3.0), DQuat::from_rotation_z(0.5), DVec3::new(2.0, 1.0, 0.5));
    let m = t.to_mat4();
    let p = DVec3::new(-1.0, 0.5, 4.0);
    expect(t.transform_point(p).approx_eq(m.transform_point(p), 1e-12), "point");
    expect(t.transform_vector(p).approx_eq(m.transform_vector(p), 1e-12), "vector");
    expect(t.to_affine().to_mat4().approx_eq(m, 1e-12), "affine");
    expect(DTransform::from_mat4(m).approx_eq(t, 1e-12), "from_mat4");
}

#[test]
fn hierarchy() {
    let parent = DTransform::new(DVec3::new(0.0, 1.0, 0.0), DQuat::from_rotation_y(1.0), DVec3::splat(2.0));
    let child = DTransform::new(DVec3::X, DQuat::from_rotation_x(0.3), DVec3::new(1.0, 2.0, 3.0));
    let both = parent * child;
    let p = DVec3::new(0.2, -0.4, 1.0);
    expect(both.transform_point(p).approx_eq(parent.transform_point(child.transform_point(p)), 1e-12), "uniform parent scale is exact");
    expect((parent.inverse() * parent).approx_eq(DTransform::identity(), 1e-12), "inverse");
}

#[test]
fn directions() {
    let t = Transform::from_translation(Vec3::new(0.0, 0.0, 5.0)).looking_at(Vec3::ZERO, Vec3::Y);
    expect(t.forward().approx_eq(-Vec3::Z, 1e-6) && t.up().approx_eq(Vec3::Y, 1e-6) && t.right().approx_eq(Vec3::X, 1e-6), "looking at origin");
    let s = Transform::<f64>::identity().looking_at(DVec3::new(1.0, 1.0, 1.0), DVec3::Y);
    expect(s.forward().approx_eq(DVec3::ONE.normalize(), 1e-12), "diagonal");
    let a = DTransform::identity();
    let b = DTransform::new(DVec3::splat(2.0), DQuat::from_rotation_z(1.0), DVec3::splat(3.0));
    let m = a.lerp(b, 0.5);
    expect(m.translation == DVec3::ONE && m.scale == DVec3::splat(2.0) && m.rotation.approx_eq(DQuat::from_rotation_z(0.5), 1e-12), "lerp");
}
