// Properties over random inputs, in f64 and f32.

use pkg::tests::suite::{close, dquat, dunit, dvec3, expect, narrow, narrowq, rng};
use pkg::{DAffine3, DMat3, DMat4, DQuat, DVec3, DVec4, Mat4, Vec3};
use std::random::Rng;

const N: usize = 500;

#[test]
fn inverse_times_matrix_is_identity() {
    let g = rng(1);
    for _ in 0..N {
        let s = DVec3::new(g.uniform(0.2, 5.0), g.uniform(0.2, 5.0), g.uniform(0.2, 5.0));
        let m = DMat4::from_scale_rotation_translation(s, dquat(ref g), dvec3(ref g, 10.0));
        expect((m.inverse() * m).approx_eq(DMat4::IDENTITY, 1e-10), "mat4");
        expect((m * m.inverse()).approx_eq(DMat4::IDENTITY, 1e-10), "mat4 right");
        let m3 = DMat3::from_cols(dvec3(ref g, 1.0), dvec3(ref g, 1.0), dvec3(ref g, 1.0));
        if m3.determinant().abs() > 1e-3 {
            expect((m3.inverse() * m3).approx_eq(DMat3::IDENTITY, 1e-8), "mat3");
        }
        let a = DAffine3::from_mat4(m);
        expect((a * a.inverse()).approx_eq(DAffine3::identity(), 1e-10), "affine3");
        // A general matrix, projective row included.
        let p = DMat4::from_cols(dvec4(ref g), dvec4(ref g), dvec4(ref g), dvec4(ref g));
        if p.determinant().abs() > 1e-2 {
            expect((p.inverse() * p).approx_eq(DMat4::IDENTITY, 1e-8), "general mat4");
        }
    }
}

fn dvec4(ref g: std::random::Xoshiro256PlusPlus) -> DVec4 { dvec3(ref g, 1.0).extend(g.uniform(-1.0, 1.0)) }

#[test]
fn quat_rotation_equals_matrix_rotation() {
    let g = rng(2);
    for _ in 0..N {
        let q = dquat(ref g);
        let v = dvec3(ref g, 10.0);
        expect((q * v).approx_eq(DMat3::from_quat(q) * v, 1e-12), "mat3");
        expect((q * v).approx_eq(DMat4::from_quat(q).transform_vector(v), 1e-12), "mat4");
        let (axis, angle) = q.to_axis_angle();
        expect((DMat3::from_axis_angle(axis, angle) * v).approx_eq(q * v, 1e-9), "axis angle matrix");
        let r = dquat(ref g);
        expect(DMat3::from_quat(q * r).approx_eq(DMat3::from_quat(q) * DMat3::from_quat(r), 1e-12), "products agree");
        close((q * v).length(), v.length(), 1e-12, "length kept");
    }
}

#[test]
fn matrix_to_quat_round_trip() {
    let g = rng(3);
    for _ in 0..N {
        let q = dquat(ref g);
        let back = DQuat::from_mat3(DMat3::from_quat(q));
        expect(back.angle_between(q) < 1e-7, "from_mat3");
    }
}

#[test]
fn slerp_is_constant_speed() {
    let g = rng(4);
    for _ in 0..N {
        let a = dquat(ref g);
        let b = dquat(ref g);
        let total = a.angle_between(b);
        let t = g.uniform(0.0, 1.0);
        let m = a.slerp(b, t);
        close(a.angle_between(m), total * t, 1e-7, "first part");
        close(m.angle_between(b), total * (1.0 - t), 1e-7, "second part");
    }
}

#[test]
fn cross_and_dot_identities() {
    let g = rng(5);
    for _ in 0..N {
        let (a, b, c) = (dvec3(ref g, 3.0), dvec3(ref g, 3.0), dvec3(ref g, 3.0));
        // a x (b x c) = b (a . c) - c (a . b)
        expect(a.cross(b.cross(c)).approx_eq(b * a.dot(c) - c * a.dot(b), 1e-10), "triple product");
        close(a.cross(b).length_squared(), a.length_squared() * b.length_squared() - a.dot(b) * a.dot(b), 1e-9, "Lagrange");
        close(DMat3::from_cols(a, b, c).determinant(), a.dot(b.cross(c)), 1e-10, "det is triple product");
        let u = dunit(ref g);
        expect(u.any_orthonormal().dot(u).abs() < 1e-12, "orthonormal");
    }
}

#[test]
fn single_precision_agrees() {
    let g = rng(6);
    for _ in 0..N {
        let q = dquat(ref g);
        let v = dvec3(ref g, 10.0);
        let want = narrow(q * v);
        expect((narrowq(q) * narrow(v)).approx_eq(want, 1e-4), "f32 rotation");
        let m = Mat4::from_quat(narrowq(q)) * Mat4::from_translation(narrow(v));
        expect((m.inverse() * m).approx_eq(Mat4::IDENTITY, 1e-4), "f32 inverse");
        expect(m.transform_point(Vec3::ZERO).approx_eq(want, 1e-3), "f32 transform");
    }
}
