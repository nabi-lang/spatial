//! `Ray<T>`: a half-line, for picking and line of sight.

use pkg::{Aabb, Plane, Real, Sphere, Vec3};
use core::reflect::Inspect;

/// The points `origin + dir * t` for `t >= 0`. The `intersect_*`
/// methods give the smallest such `t` that hits, or `none`; with a unit
/// `dir`, `t` is the distance. `#[repr(C)]`: `origin` then `dir`.
///
/// ```nabi
/// use spatial::{Ray, Sphere, Vec3};
///
/// let r = Ray::new(Vec3::new(0.0, 0.0, 5.0), -Vec3::Z);
/// assert(r.intersect_sphere(Sphere::new(Vec3::ZERO, 1.0)) == 4.0);
/// ```
#[repr(C)]
#[derive(Clone, Copy, PartialEq, Debug, Inspect)]
#[cfg_attr(feature = "nabion", derive(Nabion))]
pub struct Ray<T = f32> {
    pub origin: Vec3<T>;
    pub dir: Vec3<T>;
}

impl<T: Real> Ray<T> {
    /// The ray from `origin` along `dir`.
    ///
    /// ```nabi
    /// use spatial::{Ray, Vec3};
    ///
    /// assert(Ray::new(Vec3::ZERO, Vec3::X).dir == Vec3::X);
    /// ```
    pub const fn new(origin: Vec3<T>, dir: Vec3<T>) -> Ray<T> { Ray { origin: origin, dir: dir } }

    /// The point at parameter `t`.
    ///
    /// ```nabi
    /// use spatial::{Ray, Vec3};
    ///
    /// assert(Ray::new(Vec3::ZERO, Vec3::X).at(2.0) == Vec3::new(2.0, 0.0, 0.0));
    /// ```
    pub fn at(self, t: T) -> Vec3<T> { self.origin + self.dir * t }

    /// Where the ray first meets the box (slab test); 0 from inside.
    ///
    /// ```nabi
    /// use spatial::{Aabb, Ray, Vec3};
    ///
    /// let b = Aabb::new(Vec3::splat(-1.0), Vec3::ONE);
    /// assert(Ray::new(Vec3::new(-5.0, 0.0, 0.0), Vec3::X).intersect_aabb(b) == 4.0);
    /// assert(Ray::new(Vec3::new(-5.0, 3.0, 0.0), Vec3::X).intersect_aabb(b) == none);
    /// ```
    pub fn intersect_aabb(self, b: Aabb<T>) -> T | none {
        // 1 / 0 is infinite, which the slab arithmetic handles.
        let inv = self.dir.recip();
        let t0 = (b.min - self.origin) * inv;
        let t1 = (b.max - self.origin) * inv;
        let near = t0.min(t1).max_element();
        let far = t0.max(t1).min_element();
        if far < near || far < T::zero() { return none; }
        if near > T::zero() { near } else { T::zero() }
    }

    /// Where the ray meets the plane; `none` when parallel or behind.
    ///
    /// ```nabi
    /// use spatial::{Plane, Ray, Vec3};
    ///
    /// let ground = Plane::new(Vec3::Y, 0.0);
    /// assert(Ray::new(Vec3::new(0.0, 2.0, 0.0), -Vec3::Y).intersect_plane(ground) == 2.0);
    /// ```
    pub fn intersect_plane(self, p: Plane<T>) -> T | none {
        let denom = p.normal.dot(self.dir);
        if denom == T::zero() { return none; }
        let t = -p.distance(self.origin) / denom;
        if t >= T::zero() { t } else { none }
    }

    /// Where the ray first meets the sphere; 0 from inside.
    ///
    /// ```nabi
    /// use spatial::{Ray, Sphere, Vec3};
    ///
    /// let s = Sphere::new(Vec3::ZERO, 1.0);
    /// assert(Ray::new(Vec3::new(0.0, 2.0, 5.0), -Vec3::Z).intersect_sphere(s) == none);
    /// ```
    pub fn intersect_sphere(self, s: Sphere<T>) -> T | none {
        let m = self.origin - s.center;
        let a = self.dir.length_squared();
        let b = m.dot(self.dir);
        let c = m.length_squared() - s.radius * s.radius;
        if c <= T::zero() { return T::zero(); }
        if b > T::zero() { return none; }
        let disc = b * b - a * c;
        if disc < T::zero() { return none; }
        (-b - disc.sqrt()) / a
    }
}
