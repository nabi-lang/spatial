//! `Quat<T>`: a rotation as a unit quaternion.

use pkg::euler::{EulerOrder, axis_quat};
use pkg::{Mat3, Mat4, Real, Vec3, Vec4};
use core::ops::{Add, Mul, MulAssign, Neg, Sub};
use core::reflect::Inspect;

/// A rotation in 3D as a unit quaternion `x i + y j + z k + w`. `Quat`
/// alone is `Quat<f32>`; `DQuat` is the `f64` form. `#[repr(C)]` with
/// `x, y, z, w` in that order, as glTF and most shaders store one.
/// `a * b` rotates by `b` first, then `a`, as matrices do; `q * v`
/// rotates the vector `v`.
///
/// ```nabi
/// use spatial::{Quat, Vec3};
///
/// let q = Quat::from_rotation_z(f32::PI / 2.0);
/// assert((q * Vec3::X).approx_eq(Vec3::Y, 1e-6));
/// ```
#[repr(C)]
#[derive(Clone, Copy, PartialEq, Debug, Inspect)]
#[cfg_attr(feature = "nabion", derive(Nabion))]
pub struct Quat<T = f32> {
    pub x: T;
    pub y: T;
    pub z: T;
    pub w: T;
}

/// `Quat<f64>`.
///
/// ```nabi
/// assert(spatial::DQuat::IDENTITY.w == 1.0);
/// ```
pub type DQuat = Quat<f64>;

impl<T: Real> Quat<T> {
    /// The quaternion of its components, as given: not normalized.
    ///
    /// ```nabi
    /// assert(spatial::DQuat::from_xyzw(0.0, 0.0, 0.0, 1.0) == spatial::DQuat::IDENTITY);
    /// ```
    pub const fn from_xyzw(x: T, y: T, z: T, w: T) -> Quat<T> { Quat { x: x, y: y, z: z, w: w } }

    /// No rotation.
    ///
    /// ```nabi
    /// assert(spatial::Quat::<f32>::identity() == spatial::Quat::IDENTITY);
    /// ```
    pub fn identity() -> Quat<T> { Quat { x: T::zero(), y: T::zero(), z: T::zero(), w: T::one() } }

    /// From `[x, y, z, w]`.
    ///
    /// ```nabi
    /// assert(spatial::DQuat::from_array([0.0, 0.0, 0.0, 1.0]) == spatial::DQuat::IDENTITY);
    /// ```
    pub const fn from_array(a: [T; 4]) -> Quat<T> { Quat { x: a[0], y: a[1], z: a[2], w: a[3] } }

    /// `[x, y, z, w]`.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.to_array() == [0.0, 0.0, 0.0, 1.0]);
    /// ```
    pub const fn to_array(self) -> [T; 4] { [self.x, self.y, self.z, self.w] }

    /// `(x, y, z, w)` as a `Vec4`.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.to_vec4() == spatial::Vec4::W);
    /// ```
    pub const fn to_vec4(self) -> Vec4<T> { Vec4 { x: self.x, y: self.y, z: self.z, w: self.w } }

    /// The rotation by `angle` radians about the unit vector `axis`,
    /// counterclockwise when the axis points at the viewer.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// let q = Quat::from_axis_angle(Vec3::Y, f32::PI);
    /// assert((q * Vec3::X).approx_eq(-Vec3::X, 1e-6));
    /// ```
    pub fn from_axis_angle(axis: Vec3<T>, angle: T) -> Quat<T> {
        let half = angle * T::from_f64(0.5);
        let s = half.sin();
        Quat { x: axis.x * s, y: axis.y * s, z: axis.z * s, w: half.cos() }
    }

    /// The rotation by `angle` radians about +x.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// assert((Quat::from_rotation_x(f32::PI / 2.0) * Vec3::Y).approx_eq(Vec3::Z, 1e-6));
    /// ```
    pub fn from_rotation_x(angle: T) -> Quat<T> { Quat::from_axis_angle(Vec3::unit_x(), angle) }

    /// The rotation by `angle` radians about +y.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// assert((Quat::from_rotation_y(f32::PI / 2.0) * Vec3::Z).approx_eq(Vec3::X, 1e-6));
    /// ```
    pub fn from_rotation_y(angle: T) -> Quat<T> { Quat::from_axis_angle(Vec3::unit_y(), angle) }

    /// The rotation by `angle` radians about +z.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// assert((Quat::from_rotation_z(f32::PI / 2.0) * Vec3::X).approx_eq(Vec3::Y, 1e-6));
    /// ```
    pub fn from_rotation_z(angle: T) -> Quat<T> { Quat::from_axis_angle(Vec3::unit_z(), angle) }

    /// The rotation of Euler angles `a`, `b`, `c` in radians about the
    /// axes `order` names, in that order: see `EulerOrder`.
    ///
    /// ```nabi
    /// use spatial::{EulerOrder, Quat};
    ///
    /// let q = Quat::from_euler(EulerOrder::YXZ, 0.5, 0.0, 0.0);
    /// assert(q.approx_eq(Quat::from_rotation_y(0.5), 1e-6));
    /// ```
    pub fn from_euler(order: EulerOrder, a: T, b: T, c: T) -> Quat<T> {
        let (i, j, k) = order.axes();
        axis_quat(i, a) * axis_quat(j, b) * axis_quat(k, c)
    }

    /// The Euler angles `(a, b, c)` of this rotation in `order`, so that
    /// `Quat::from_euler(order, a, b, c)` gives it back. `b` is in
    /// `-pi/2..=pi/2`, `a` and `c` in `-pi..=pi`; at `b = +-pi/2` (gimbal
    /// lock) `c` is 0.
    ///
    /// ```nabi
    /// use spatial::{EulerOrder, Quat};
    ///
    /// let q = Quat::<f64>::from_euler(EulerOrder::ZYX, 0.1, 0.2, 0.3);
    /// let (a, b, c) = q.to_euler(EulerOrder::ZYX);
    /// assert((a - 0.1).abs() < 1e-12 && (b - 0.2).abs() < 1e-12 && (c - 0.3).abs() < 1e-12);
    /// ```
    pub fn to_euler(self, order: EulerOrder) -> (T, T, T) { Mat3::from_quat(self).to_euler(order) }

    /// The rotation part of a rotation matrix (orthonormal columns, no
    /// scale).
    ///
    /// ```nabi
    /// use spatial::{Mat3, Quat};
    ///
    /// let q = Quat::from_rotation_x(0.7);
    /// assert(Quat::from_mat3(Mat3::from_quat(q)).approx_eq(q, 1e-6));
    /// ```
    pub fn from_mat3(m: Mat3<T>) -> Quat<T> {
        let (m00, m10, m20) = (m.x_axis.x, m.x_axis.y, m.x_axis.z);
        let (m01, m11, m21) = (m.y_axis.x, m.y_axis.y, m.y_axis.z);
        let (m02, m12, m22) = (m.z_axis.x, m.z_axis.y, m.z_axis.z);
        let one = T::one();
        let quarter = T::from_f64(0.25);
        let two = T::from_f64(2.0);
        // Shepperd: divide by the largest of the four candidates.
        let trace = m00 + m11 + m22;
        if trace > T::zero() {
            let s = (trace + one).sqrt() * two;
            Quat { x: (m21 - m12) / s, y: (m02 - m20) / s, z: (m10 - m01) / s, w: quarter * s }
        } else if m00 > m11 && m00 > m22 {
            let s = (one + m00 - m11 - m22).sqrt() * two;
            Quat { x: quarter * s, y: (m01 + m10) / s, z: (m02 + m20) / s, w: (m21 - m12) / s }
        } else if m11 > m22 {
            let s = (one + m11 - m00 - m22).sqrt() * two;
            Quat { x: (m01 + m10) / s, y: quarter * s, z: (m12 + m21) / s, w: (m02 - m20) / s }
        } else {
            let s = (one + m22 - m00 - m11).sqrt() * two;
            Quat { x: (m02 + m20) / s, y: (m12 + m21) / s, z: quarter * s, w: (m10 - m01) / s }
        }
    }

    /// The rotation part of a rotation-and-translation matrix.
    ///
    /// ```nabi
    /// use spatial::{Mat4, Quat};
    ///
    /// let q = Quat::from_rotation_y(0.3);
    /// assert(Quat::from_mat4(Mat4::from_quat(q)).approx_eq(q, 1e-6));
    /// ```
    pub fn from_mat4(m: Mat4<T>) -> Quat<T> { Quat::from_mat3(Mat3::from_mat4(m)) }

    /// The shortest rotation that turns the unit vector `from` into the
    /// unit vector `to`. Opposite vectors turn by pi about some axis at
    /// right angles to them.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// let q = Quat::from_rotation_arc(Vec3::X, Vec3::Z);
    /// assert((q * Vec3::X).approx_eq(Vec3::Z, 1e-6));
    /// ```
    pub fn from_rotation_arc(from: Vec3<T>, to: Vec3<T>) -> Quat<T> {
        let d = from.dot(to);
        if d < T::from_f64(-0.999999) {
            return Quat::from_axis_angle(from.any_orthonormal(), T::PI);
        }
        let c = from.cross(to);
        Quat { x: c.x, y: c.y, z: c.z, w: T::one() + d }.normalize()
    }

    /// The unit axis and the angle in radians, `0..=pi` for a
    /// normalized quaternion with `w >= 0`; no rotation gives `(+x, 0)`.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// let (axis, angle) = Quat::from_axis_angle(Vec3::Z, 0.5).to_axis_angle();
    /// assert(axis.approx_eq(Vec3::Z, 1e-6) && (angle - 0.5).abs() < 1e-6);
    /// ```
    pub fn to_axis_angle(self) -> (Vec3<T>, T) {
        let q = if self.w < T::zero() { -self } else { self };
        let w = q.w.min(T::one());
        let s = (T::one() - w * w).sqrt();
        let angle = T::from_f64(2.0) * w.acos();
        if s < T::from_f64(1e-6) {
            (Vec3::unit_x(), angle)
        } else {
            (Vec3 { x: q.x / s, y: q.y / s, z: q.z / s }, angle)
        }
    }

    /// `(-x, -y, -z, w)`: the inverse of a unit quaternion.
    ///
    /// ```nabi
    /// let q = spatial::DQuat::from_rotation_x(0.4);
    /// assert((q * q.conjugate()).approx_eq(spatial::DQuat::IDENTITY, 1e-12));
    /// ```
    pub fn conjugate(self) -> Quat<T> { Quat { x: -self.x, y: -self.y, z: -self.z, w: self.w } }

    /// The inverse rotation. For a unit quaternion this is `conjugate`;
    /// any other is divided by its squared length too.
    ///
    /// ```nabi
    /// let q = spatial::DQuat::from_rotation_y(1.0) * 2.0;
    /// assert((q * q.inverse()).approx_eq(spatial::DQuat::IDENTITY, 1e-12));
    /// ```
    pub fn inverse(self) -> Quat<T> { self.conjugate() * (T::one() / self.length_squared()) }

    /// The four-dimensional dot product; `+-1` for the same rotation.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.dot(spatial::Quat::IDENTITY) == 1.0);
    /// ```
    pub fn dot(self, o: Quat<T>) -> T { self.to_vec4().dot(o.to_vec4()) }

    /// The squared length.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.length_squared() == 1.0);
    /// ```
    pub fn length_squared(self) -> T { self.dot(self) }

    /// The length; 1 for a rotation.
    ///
    /// ```nabi
    /// assert((spatial::Quat::from_rotation_z(2.0).length() - 1.0).abs() < 1e-6);
    /// ```
    pub fn length(self) -> T { self.length_squared().sqrt() }

    /// The quaternion scaled to length 1.
    ///
    /// ```nabi
    /// assert((spatial::Quat::IDENTITY * 3.0).normalize() == spatial::Quat::IDENTITY);
    /// ```
    pub fn normalize(self) -> Quat<T> { self * (T::one() / self.length()) }

    /// Whether the length is 1, within `1e-4` of the squared length.
    ///
    /// ```nabi
    /// assert(spatial::Quat::from_rotation_x(1.0).is_normalized());
    /// ```
    pub fn is_normalized(self) -> bool { (self.length_squared() - T::one()).abs() <= T::from_f64(1e-4) }

    /// The angle in radians between the two rotations, `0..=pi`.
    ///
    /// ```nabi
    /// use spatial::DQuat;
    ///
    /// let a = DQuat::from_rotation_z(0.25);
    /// assert((a.angle_between(DQuat::IDENTITY) - 0.25).abs() < 1e-12);
    /// ```
    pub fn angle_between(self, o: Quat<T>) -> T {
        T::from_f64(2.0) * self.dot(o).abs().min(T::one()).acos()
    }

    /// The vector `v` rotated, the same as `self * v`.
    ///
    /// ```nabi
    /// use spatial::{Quat, Vec3};
    ///
    /// let q = Quat::from_rotation_x(f32::PI);
    /// assert(q.rotate(Vec3::Y).approx_eq(-Vec3::Y, 1e-6));
    /// ```
    pub fn rotate(self, v: Vec3<T>) -> Vec3<T> {
        let u = Vec3 { x: self.x, y: self.y, z: self.z };
        let t = u.cross(v) * T::from_f64(2.0);
        v + t * self.w + u.cross(t)
    }

    /// Linear interpolation of the components, then normalized: cheaper
    /// than `slerp`, constant speed only for small steps. Takes the short
    /// way round.
    ///
    /// ```nabi
    /// use spatial::Quat;
    ///
    /// let q = Quat::IDENTITY.nlerp(Quat::from_rotation_z(1.0), 0.5);
    /// assert(q.approx_eq(Quat::from_rotation_z(0.5), 1e-6));
    /// ```
    pub fn nlerp(self, o: Quat<T>, t: T) -> Quat<T> {
        let b = if self.dot(o) < T::zero() { -o } else { o };
        (self + (b - self) * t).normalize()
    }

    /// Spherical interpolation: constant angular speed, `t = 0` gives
    /// `self` and `t = 1` gives `o`. Takes the short way round; nearly
    /// equal rotations fall back to `nlerp`.
    ///
    /// ```nabi
    /// use spatial::Quat;
    ///
    /// let q = Quat::<f64>::IDENTITY.slerp(Quat::from_rotation_y(2.0), 0.25);
    /// assert(q.approx_eq(Quat::from_rotation_y(0.5), 1e-12));
    /// ```
    pub fn slerp(self, o: Quat<T>, t: T) -> Quat<T> {
        let d = self.dot(o);
        let b = if d < T::zero() { -o } else { o };
        let d = d.abs();
        if d > T::from_f64(0.9995) {
            return (self + (b - self) * t).normalize();
        }
        let theta = d.acos();
        let s = theta.sin();
        let wa = ((T::one() - t) * theta).sin() / s;
        let wb = (t * theta).sin() / s;
        self * wa + b * wb
    }

    /// Whether every component is within `eps` of `o`'s. `q` and `-q`
    /// are the same rotation but are not approximately equal here;
    /// compare `angle_between` for that.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.approx_eq(spatial::Quat::from_rotation_x(1e-7), 1e-6));
    /// ```
    pub fn approx_eq(self, o: Quat<T>, eps: T) -> bool { self.to_vec4().approx_eq(o.to_vec4(), eps) }

    /// Whether no component is NaN or infinite.
    ///
    /// ```nabi
    /// assert(spatial::Quat::IDENTITY.is_finite());
    /// ```
    pub fn is_finite(self) -> bool { self.to_vec4().is_finite() }
}

#[impl_macro(quat_consts)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Quat<@t> {
                /// No rotation, `(0, 0, 0, 1)`.
                ///
                /// ```nabi
                /// assert(spatial::Quat::IDENTITY == spatial::Quat::identity());
                /// ```
                pub const IDENTITY: Quat<@t> = Quat { x: 0.0, y: 0.0, z: 0.0, w: 1.0 };
            }

            impl Mul<Quat<@t>> for @t {
                type Output = Quat<@t>;
                fn mul(self, q: Quat<@t>) -> Quat<@t> { q * self }
            }
        }
    }
}

quat_consts!(f32, f64);

/// The Hamilton product: `a * b` rotates by `b`, then by `a`.
impl<T: Real> Mul for Quat<T> {
    type Output = Quat<T>;
    fn mul(self, b: Quat<T>) -> Quat<T> {
        let a = self;
        Quat {
            x: a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
            y: a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
            z: a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
            w: a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z,
        }
    }
}

impl<T: Real> MulAssign for Quat<T> {
    fn mul_assign(ref self, b: Quat<T>) { self = self * b; }
}

/// `q * v`: `v` rotated.
impl<T: Real> Mul<Vec3<T>> for Quat<T> {
    type Output = Vec3<T>;
    fn mul(self, v: Vec3<T>) -> Vec3<T> { self.rotate(v) }
}

// Component-wise, for blending and interpolation.

impl<T: Real> Add for Quat<T> {
    type Output = Quat<T>;
    fn add(self, o: Quat<T>) -> Quat<T> { Quat { x: self.x + o.x, y: self.y + o.y, z: self.z + o.z, w: self.w + o.w } }
}

impl<T: Real> Sub for Quat<T> {
    type Output = Quat<T>;
    fn sub(self, o: Quat<T>) -> Quat<T> { Quat { x: self.x - o.x, y: self.y - o.y, z: self.z - o.z, w: self.w - o.w } }
}

impl<T: Real> Mul<T> for Quat<T> {
    type Output = Quat<T>;
    fn mul(self, s: T) -> Quat<T> { Quat { x: self.x * s, y: self.y * s, z: self.z * s, w: self.w * s } }
}

impl<T: Real> Neg for Quat<T> {
    type Output = Quat<T>;
    fn neg(self) -> Quat<T> { Quat { x: -self.x, y: -self.y, z: -self.z, w: -self.w } }
}

/// `(x, y, z, w)`.
impl<T: Real> Display for Quat<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) { try Display::fmt(self.to_vec4(), ref f) }
}
