//! `Mat2<T>`: a 2x2 matrix.

use pkg::{Real, Vec2};
use core::ops::{Add, Mul, MulAssign, Sub};
use core::reflect::Inspect;

/// A 2x2 matrix of two column vectors, for 2D rotation and scale.
/// `Mat2` alone is `Mat2<f32>`. `#[repr(C)]`: `x_axis` then `y_axis`,
/// four `T`s column by column.
///
/// ```nabi
/// use spatial::{Mat2, Vec2};
///
/// let m = Mat2::from_cols(Vec2::new(1.0, 2.0), Vec2::new(3.0, 4.0));
/// assert(m * Vec2::new(1.0, 0.0) == Vec2::new(1.0, 2.0));
/// assert(m.determinant() == -2.0);
/// ```
#[repr(C)]
#[derive(Clone, Copy, PartialEq, Debug, Inspect)]
#[cfg_attr(feature = "nabion", derive(Nabion))]
pub struct Mat2<T = f32> {
    pub x_axis: Vec2<T>;
    pub y_axis: Vec2<T>;
}

impl<T: Real> Mat2<T> {
    /// The matrix of its columns.
    ///
    /// ```nabi
    /// use spatial::{Mat2, Vec2};
    ///
    /// assert(Mat2::from_cols(Vec2::X, Vec2::Y) == Mat2::IDENTITY);
    /// ```
    pub const fn from_cols(x_axis: Vec2<T>, y_axis: Vec2<T>) -> Mat2<T> { Mat2 { x_axis: x_axis, y_axis: y_axis } }

    /// From four values, column by column.
    ///
    /// ```nabi
    /// assert(spatial::DMat2::from_cols_array([1.0, 0.0, 0.0, 1.0]) == spatial::DMat2::IDENTITY);
    /// ```
    pub fn from_cols_array(a: [T; 4]) -> Mat2<T> { Mat2 { x_axis: Vec2::new(a[0], a[1]), y_axis: Vec2::new(a[2], a[3]) } }

    /// The four values column by column, as a GPU reads them.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::IDENTITY.to_cols_array() == [1.0, 0.0, 0.0, 1.0]);
    /// ```
    pub fn to_cols_array(self) -> [T; 4] { [self.x_axis.x, self.x_axis.y, self.y_axis.x, self.y_axis.y] }

    /// The identity.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::<f32>::identity() == spatial::Mat2::IDENTITY);
    /// ```
    pub fn identity() -> Mat2<T> { Mat2 { x_axis: Vec2::unit_x(), y_axis: Vec2::unit_y() } }

    /// All zero.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::<f32>::zero().determinant() == 0.0);
    /// ```
    pub fn zero() -> Mat2<T> { Mat2 { x_axis: Vec2::zero(), y_axis: Vec2::zero() } }

    /// The diagonal matrix of `d`, a scale.
    ///
    /// ```nabi
    /// use spatial::{Mat2, Vec2};
    ///
    /// assert(Mat2::from_diagonal(Vec2::new(2.0, 3.0)) * Vec2::ONE == Vec2::new(2.0, 3.0));
    /// ```
    pub fn from_diagonal(d: Vec2<T>) -> Mat2<T> {
        Mat2 { x_axis: Vec2::new(d.x, T::zero()), y_axis: Vec2::new(T::zero(), d.y) }
    }

    /// The counterclockwise rotation by `angle` radians.
    ///
    /// ```nabi
    /// use spatial::{Mat2, Vec2};
    ///
    /// assert((Mat2::from_angle(f32::PI / 2.0) * Vec2::X).approx_eq(Vec2::Y, 1e-6));
    /// ```
    pub fn from_angle(angle: T) -> Mat2<T> {
        let (s, c) = (angle.sin(), angle.cos());
        Mat2 { x_axis: Vec2::new(c, s), y_axis: Vec2::new(-s, c) }
    }

    /// Scale by `scale`, then rotate by `angle` radians.
    ///
    /// ```nabi
    /// use spatial::{Mat2, Vec2};
    ///
    /// let m = Mat2::from_scale_angle(Vec2::splat(2.0), f32::PI / 2.0);
    /// assert((m * Vec2::X).approx_eq(Vec2::new(0.0, 2.0), 1e-6));
    /// ```
    pub fn from_scale_angle(scale: Vec2<T>, angle: T) -> Mat2<T> {
        Mat2::from_angle(angle) * Mat2::from_diagonal(scale)
    }

    /// Column `i` (0 or 1).
    ///
    /// ```nabi
    /// assert(spatial::Mat2::IDENTITY.col(1) == spatial::Vec2::Y);
    /// ```
    #[track_caller]
    pub fn col(self, i: usize) -> Vec2<T> {
        match i {
            0 => self.x_axis,
            1 => self.y_axis,
            _ => panic(f"Mat2 column {i} is out of range 0..2"),
        }
    }

    /// Row `i` (0 or 1).
    ///
    /// ```nabi
    /// use spatial::{Mat2, Vec2};
    ///
    /// let m = Mat2::from_cols_array([1.0, 2.0, 3.0, 4.0]);
    /// assert(m.row(0) == Vec2::new(1.0, 3.0));
    /// ```
    pub fn row(self, i: usize) -> Vec2<T> { Vec2::new(self.x_axis[i], self.y_axis[i]) }

    /// The transpose.
    ///
    /// ```nabi
    /// let m = spatial::Mat2::from_cols_array([1.0, 2.0, 3.0, 4.0]);
    /// assert(m.transpose().to_cols_array() == [1.0, 3.0, 2.0, 4.0]);
    /// ```
    pub fn transpose(self) -> Mat2<T> { Mat2 { x_axis: self.row(0), y_axis: self.row(1) } }

    /// The determinant.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::from_cols_array([1.0, 2.0, 3.0, 4.0]).determinant() == -2.0);
    /// ```
    pub fn determinant(self) -> T { self.x_axis.x * self.y_axis.y - self.y_axis.x * self.x_axis.y }

    /// The inverse. A singular matrix gives infinite or NaN entries;
    /// `try_inverse` gives `none` for it instead.
    ///
    /// ```nabi
    /// use spatial::DMat2;
    ///
    /// let m = DMat2::from_cols_array([1.0, 2.0, 3.0, 4.0]);
    /// assert((m * m.inverse()).approx_eq(DMat2::IDENTITY, 1e-12));
    /// ```
    pub fn inverse(self) -> Mat2<T> {
        let r = T::one() / self.determinant();
        Mat2 {
            x_axis: Vec2::new(self.y_axis.y * r, -self.x_axis.y * r),
            y_axis: Vec2::new(-self.y_axis.x * r, self.x_axis.x * r),
        }
    }

    /// The inverse, or `none` when the determinant is zero or the
    /// result is not finite.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::<f32>::zero().try_inverse() == none);
    /// ```
    pub fn try_inverse(self) -> Mat2<T> | none {
        let inv = self.inverse();
        if self.determinant() != T::zero() && inv.is_finite() { inv } else { none }
    }

    /// Whether every entry is within `eps` of `o`'s.
    ///
    /// ```nabi
    /// use spatial::Mat2;
    ///
    /// assert(Mat2::IDENTITY.approx_eq(Mat2::from_angle(1e-7), 1e-6));
    /// ```
    pub fn approx_eq(self, o: Mat2<T>, eps: T) -> bool {
        self.x_axis.approx_eq(o.x_axis, eps) && self.y_axis.approx_eq(o.y_axis, eps)
    }

    /// Whether no entry is NaN or infinite.
    ///
    /// ```nabi
    /// assert(spatial::Mat2::IDENTITY.is_finite());
    /// ```
    pub fn is_finite(self) -> bool { self.x_axis.is_finite() && self.y_axis.is_finite() }
}

#[impl_macro(mat2_consts)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Mat2<@t> {
                /// The identity.
                ///
                /// ```nabi
                /// assert(spatial::Mat2::IDENTITY.determinant() == 1.0);
                /// ```
                pub const IDENTITY: Mat2<@t> = Mat2 { x_axis: Vec2 { x: 1.0, y: 0.0 }, y_axis: Vec2 { x: 0.0, y: 1.0 } };
                /// All zero.
                ///
                /// ```nabi
                /// assert(spatial::Mat2::ZERO == spatial::Mat2::zero());
                /// ```
                pub const ZERO: Mat2<@t> = Mat2 { x_axis: Vec2 { x: 0.0, y: 0.0 }, y_axis: Vec2 { x: 0.0, y: 0.0 } };
            }
        }
    }
}

mat2_consts!(f32, f64);

/// `a * b` applies `b` first.
impl<T: Real> Mul for Mat2<T> {
    type Output = Mat2<T>;
    fn mul(self, o: Mat2<T>) -> Mat2<T> { Mat2 { x_axis: self * o.x_axis, y_axis: self * o.y_axis } }
}

impl<T: Real> Mul<Vec2<T>> for Mat2<T> {
    type Output = Vec2<T>;
    fn mul(self, v: Vec2<T>) -> Vec2<T> { self.x_axis * v.x + self.y_axis * v.y }
}

impl<T: Real> Mul<T> for Mat2<T> {
    type Output = Mat2<T>;
    fn mul(self, s: T) -> Mat2<T> { Mat2 { x_axis: self.x_axis * s, y_axis: self.y_axis * s } }
}

impl<T: Real> Add for Mat2<T> {
    type Output = Mat2<T>;
    fn add(self, o: Mat2<T>) -> Mat2<T> { Mat2 { x_axis: self.x_axis + o.x_axis, y_axis: self.y_axis + o.y_axis } }
}

impl<T: Real> Sub for Mat2<T> {
    type Output = Mat2<T>;
    fn sub(self, o: Mat2<T>) -> Mat2<T> { Mat2 { x_axis: self.x_axis - o.x_axis, y_axis: self.y_axis - o.y_axis } }
}

impl<T: Real> MulAssign for Mat2<T> {
    fn mul_assign(ref self, o: Mat2<T>) { self = self * o; }
}

/// `[x_axis, y_axis]`, the columns.
impl<T: Real> Display for Mat2<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("[");
        try Display::fmt(self.x_axis, ref f);
        try f.write_str(", ");
        try Display::fmt(self.y_axis, ref f);
        try f.write_str("]")
    }
}
