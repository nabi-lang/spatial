//! `Vec2<T>`: 2 components, `x`, `y`, of a `Scalar`.

use pkg::vec::Vec3;
use pkg::{Real, Scalar};
use core::index::Index;
use core::ops::{Add, AddAssign, Div, DivAssign, Mul, MulAssign, Neg, Sub, SubAssign};
use core::reflect::Inspect;

/// A 2-component vector. `Vec2` alone is `Vec2<f32>`; `DVec2`,
/// `IVec2` and `UVec2` are the `f64`, `i32` and `u32` forms.
/// `#[repr(C)]`: two `T`s in order, no padding; `Vec2` (f32) is 8
/// bytes, aligned to 4, as a `vec2<f32>` in WGSL.
///
/// ```nabi
/// use spatial::Vec2;
///
/// let v = Vec2::new(1.0, 2.0);
/// assert(v.x == 1.0 && v.y == 2.0);
/// assert(Vec2::<f32>::size() == 8);
/// ```
#[repr(C)]
#[derive(Clone, Copy, PartialEq, Debug, Inspect)]
#[cfg_attr(feature = "nabion", derive(Nabion))]
pub struct Vec2<T = f32> {
    pub x: T;
    pub y: T;
}

impl<T: Scalar> Vec2<T> {
    /// The vector of its components.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).y == 2.0);
    /// ```
    pub const fn new(x: T, y: T) -> Vec2<T> {
        Vec2 { x: x, y: y }
    }

    /// Every component `v`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(2.0) == Vec2::new(2.0, 2.0));
    /// ```
    pub const fn splat(v: T) -> Vec2<T> {
        Vec2 { x: v, y: v }
    }

    /// All zero.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero() == Vec2::splat(0.0));
    /// ```
    pub fn zero() -> Vec2<T> {
        Vec2::splat(T::zero())
    }

    /// All one.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::one() == Vec2::splat(1.0));
    /// ```
    pub fn one() -> Vec2<T> {
        Vec2::splat(T::one())
    }

    /// The unit vector along `x`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::unit_x().x == 1.0);
    /// ```
    pub fn unit_x() -> Vec2<T> {
        Vec2 { x: T::one(), y: T::zero() }
    }

    /// The unit vector along `y`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::unit_y().y == 1.0);
    /// ```
    pub fn unit_y() -> Vec2<T> {
        Vec2 { x: T::zero(), y: T::one() }
    }

    /// From `[x, y]`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::from_array([1.0, 2.0]) == Vec2::new(1.0, 2.0));
    /// ```
    pub const fn from_array(a: [T; 2]) -> Vec2<T> {
        Vec2 { x: a[0], y: a[1] }
    }

    /// `[x, y]`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).to_array() == [1.0, 2.0]);
    /// ```
    pub const fn to_array(self) -> [T; 2] {
        [self.x, self.y]
    }

    /// The dot product.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).dot(Vec2::new(3.0, 4.0)) == 11.0);
    /// ```
    pub fn dot(self, o: Vec2<T>) -> T {
        self.x * o.x + self.y * o.y
    }

    /// `self.dot(self)`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).length_squared() == Vec2::new(1.0, 2.0).dot(Vec2::new(1.0, 2.0)));
    /// ```
    pub fn length_squared(self) -> T {
        self.dot(self)
    }

    /// The squared distance to `o`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().distance_squared(Vec2::splat(1.0)) == 2.0);
    /// ```
    pub fn distance_squared(self, o: Vec2<T>) -> T {
        (self - o).length_squared()
    }

    /// The smaller of each pair of components.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).min(Vec2::splat(1.5)).y == 1.5);
    /// ```
    pub fn min(self, o: Vec2<T>) -> Vec2<T> {
        Vec2 { x: if o.x < self.x { o.x } else { self.x }, y: if o.y < self.y { o.y } else { self.y } }
    }

    /// The larger of each pair of components.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).max(Vec2::splat(1.5)).x == 1.5);
    /// ```
    pub fn max(self, o: Vec2<T>) -> Vec2<T> {
        Vec2 { x: if o.x > self.x { o.x } else { self.x }, y: if o.y > self.y { o.y } else { self.y } }
    }

    /// Each component limited to `lo..=hi`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).clamp(Vec2::splat(1.5), Vec2::splat(1.5)) == Vec2::splat(1.5));
    /// ```
    pub fn clamp(self, lo: Vec2<T>, hi: Vec2<T>) -> Vec2<T> {
        self.max(lo).min(hi)
    }

    /// The smallest component.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).min_element() == 1.0);
    /// ```
    pub fn min_element(self) -> T {
        let m = self.x;
        if self.y < m { m = self.y; }
        m
    }

    /// The largest component.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).max_element() == 2.0);
    /// ```
    pub fn max_element(self) -> T {
        let m = self.x;
        if self.y > m { m = self.y; }
        m
    }

    /// The sum of the components.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).element_sum() == 3.0);
    /// ```
    pub fn element_sum(self) -> T {
        self.x + self.y
    }

    /// The product of the components.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).element_product() == 2.0);
    /// ```
    pub fn element_product(self) -> T {
        self.x * self.y
    }

    /// Each component through `f`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).map(|c: f64| -> f64 { c * 2.0 }) == Vec2::new(1.0, 2.0) * 2.0);
    /// ```
    pub fn map<U>(self, f: fn(T) -> U) -> Vec2<U> {
        Vec2 { x: f(self.x), y: f(self.y) }
    }

    /// `(y, x)`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).yx() == Vec2::new(2.0, 1.0));
    /// ```
    pub const fn yx(self) -> Vec2<T> {
        Vec2 { x: self.y, y: self.x }
    }

    /// `(x, y, z)`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).extend(3.0).z == 3.0);
    /// ```
    pub const fn extend(self, z: T) -> Vec3<T> {
        Vec3 { x: self.x, y: self.y, z: z }
    }
}

impl<T: Real> Vec2<T> {
    /// The length.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(3.0, 4.0).length() == 5.0);
    /// ```
    pub fn length(self) -> T {
        self.length_squared().sqrt()
    }

    /// `1 / length`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(0.0, 4.0).length_recip() == 0.25);
    /// ```
    pub fn length_recip(self) -> T {
        T::one() / self.length()
    }

    /// The distance to `o`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().distance(Vec2::new(3.0, 4.0)) == 5.0);
    /// ```
    pub fn distance(self, o: Vec2<T>) -> T {
        (self - o).length()
    }

    /// The vector of length 1 in the same direction. A zero vector gives
    /// NaN components; `try_normalize` or `normalize_or_zero` handle it.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(0.0, 2.0).normalize() == Vec2::new(0.0, 1.0));
    /// ```
    pub fn normalize(self) -> Vec2<T> {
        self * self.length_recip()
    }

    /// The unit vector, or `none` for a zero, tiny or non-finite one.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().try_normalize() == none);
    /// ```
    pub fn try_normalize(self) -> Vec2<T> | none {
        let r = self.length_recip();
        if r.is_finite() && r > T::zero() { self * r } else { none }
    }

    /// The unit vector, or zero where `try_normalize` gives `none`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().normalize_or_zero() == Vec2::zero());
    /// ```
    pub fn normalize_or_zero(self) -> Vec2<T> {
        match self.try_normalize() {
            v: Vec2<T> => v,
            none => Vec2::zero(),
        }
    }

    /// Whether the length is 1, within `1e-4` of the squared length.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::unit_x().is_normalized());
    /// ```
    pub fn is_normalized(self) -> bool {
        (self.length_squared() - T::one()).abs() <= T::from_f64(1e-4)
    }

    /// `self + (o - self) * t`: `t = 0` gives `self`, `t = 1` gives `o`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().lerp(Vec2::splat(2.0), 0.5) == Vec2::one());
    /// ```
    pub fn lerp(self, o: Vec2<T>, t: T) -> Vec2<T> {
        self + (o - self) * t
    }

    /// The midpoint of `self` and `o`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f32>::zero().midpoint(Vec2::splat(2.0)) == Vec2::one());
    /// ```
    pub fn midpoint(self, o: Vec2<T>) -> Vec2<T> {
        (self + o) * T::from_f64(0.5)
    }

    /// Whether every component is within `eps` of `o`'s.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 2.0).approx_eq(Vec2::new(1.0, 2.0) + Vec2::splat(1e-7), 1e-6));
    /// ```
    pub fn approx_eq(self, o: Vec2<T>, eps: T) -> bool {
        (self.x - o.x).abs() <= eps && (self.y - o.y).abs() <= eps
    }

    /// Each component's absolute value.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert((-Vec2::<f32>::one()).abs() == Vec2::one());
    /// ```
    pub fn abs(self) -> Vec2<T> {
        Vec2 { x: self.x.abs(), y: self.y.abs() }
    }

    /// Each component rounded down.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(1.5).floor() == Vec2::one());
    /// ```
    pub fn floor(self) -> Vec2<T> {
        Vec2 { x: self.x.floor(), y: self.y.floor() }
    }

    /// Each component rounded up.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(0.5).ceil() == Vec2::one());
    /// ```
    pub fn ceil(self) -> Vec2<T> {
        Vec2 { x: self.x.ceil(), y: self.y.ceil() }
    }

    /// Each component rounded to the nearest integer, half away from zero.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(0.5).round() == Vec2::one());
    /// ```
    pub fn round(self) -> Vec2<T> {
        Vec2 { x: self.x.round(), y: self.y.round() }
    }

    /// `1 / c` of each component.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(4.0).recip() == Vec2::splat(0.25));
    /// ```
    pub fn recip(self) -> Vec2<T> {
        Vec2 { x: T::one() / self.x, y: T::one() / self.y }
    }

    /// Whether no component is NaN or infinite.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(!Vec2::splat(1.0 / 0.0).is_finite());
    /// ```
    pub fn is_finite(self) -> bool {
        self.x.is_finite() && self.y.is_finite()
    }

    /// The part of `self` along `onto` (which need not be unit length).
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(2.0).project_onto(Vec2::unit_x()) == Vec2::unit_x() * 2.0);
    /// ```
    pub fn project_onto(self, onto: Vec2<T>) -> Vec2<T> {
        onto * (self.dot(onto) / onto.length_squared())
    }

    /// The part of `self` at right angles to `from`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(2.0).reject_from(Vec2::unit_x()).x == 0.0);
    /// ```
    pub fn reject_from(self, from: Vec2<T>) -> Vec2<T> {
        self - self.project_onto(from)
    }

    /// `self` mirrored by the plane through 0 with unit normal `n`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::splat(1.0).reflect(Vec2::unit_x()).x == -1.0);
    /// ```
    pub fn reflect(self, n: Vec2<T>) -> Vec2<T> {
        self - n * (T::from_f64(2.0) * self.dot(n))
    }

    /// The angle to `o` in radians, in `0..=pi`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert((Vec2::<f64>::unit_x().angle_between(Vec2::unit_y()) - f64::PI / 2.0).abs() < 1e-12);
    /// ```
    pub fn angle_between(self, o: Vec2<T>) -> T {
        let c = self.dot(o) / (self.length_squared() * o.length_squared()).sqrt();
        c.max(-T::one()).min(T::one()).acos()
    }

    /// The unit vector at `angle` radians from +x, counterclockwise.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f64>::from_angle(0.0) == Vec2::unit_x());
    /// ```
    pub fn from_angle(angle: T) -> Vec2<T> {
        Vec2 { x: angle.cos(), y: angle.sin() }
    }

    /// The angle from +x in radians, in `-pi..=pi` (`atan2(y, x)`).
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::<f64>::unit_x().to_angle() == 0.0);
    /// ```
    pub fn to_angle(self) -> T {
        self.y.atan2(self.x)
    }

    /// `self` turned 90 degrees counterclockwise, `(-y, x)`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 0.0).perp() == Vec2::new(0.0, 1.0));
    /// ```
    pub fn perp(self) -> Vec2<T> {
        Vec2 { x: -self.y, y: self.x }
    }

    /// The 2D cross product `x * o.y - y * o.x`: positive when `o` is
    /// counterclockwise of `self`.
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(1.0, 0.0).perp_dot(Vec2::new(0.0, 1.0)) == 1.0);
    /// ```
    pub fn perp_dot(self, o: Vec2<T>) -> T {
        self.x * o.y - self.y * o.x
    }

    /// `o` rotated by the unit vector `self` (complex multiplication).
    ///
    /// ```nabi
    /// use spatial::Vec2;
    ///
    /// assert(Vec2::new(0.0, 1.0).rotate(Vec2::new(1.0, 0.0)) == Vec2::new(0.0, 1.0));
    /// ```
    pub fn rotate(self, o: Vec2<T>) -> Vec2<T> {
        Vec2 { x: self.x * o.x - self.y * o.y, y: self.y * o.x + self.x * o.y }
    }
}

#[impl_macro(vec2_consts)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Vec2<@t> {
                /// All zero.
                ///
                /// ```nabi
                /// use spatial::Vec2;
                ///
                /// assert(Vec2::ZERO == Vec2::zero());
                /// ```
                pub const ZERO: Vec2<@t> = Vec2 { x: 0 as @t, y: 0 as @t };
                /// All one.
                ///
                /// ```nabi
                /// use spatial::Vec2;
                ///
                /// assert(Vec2::ONE == Vec2::one());
                /// ```
                pub const ONE: Vec2<@t> = Vec2 { x: 1 as @t, y: 1 as @t };
                /// The unit vector along `x`.
                ///
                /// ```nabi
                /// use spatial::Vec2;
                ///
                /// assert(Vec2::X == Vec2::unit_x());
                /// ```
                pub const X: Vec2<@t> = Vec2 { x: 1 as @t, y: 0 as @t };
                /// The unit vector along `y`.
                ///
                /// ```nabi
                /// use spatial::Vec2;
                ///
                /// assert(Vec2::Y == Vec2::unit_y());
                /// ```
                pub const Y: Vec2<@t> = Vec2 { x: 0 as @t, y: 1 as @t };
            }
        }
    }
}

vec2_consts!(f32, f64, i32, u32);

// Component-wise; a scalar on the right applies to every component.

impl<T: Scalar> Add for Vec2<T> {
    type Output = Vec2<T>;
    fn add(self, o: Vec2<T>) -> Vec2<T> { Vec2 { x: self.x + o.x, y: self.y + o.y } }
}

impl<T: Scalar> Add<T> for Vec2<T> {
    type Output = Vec2<T>;
    fn add(self, s: T) -> Vec2<T> { Vec2 { x: self.x + s, y: self.y + s } }
}

impl<T: Scalar> AddAssign for Vec2<T> {
    fn add_assign(ref self, o: Vec2<T>) { self = self + o; }
}

impl<T: Scalar> AddAssign<T> for Vec2<T> {
    fn add_assign(ref self, s: T) { self = self + s; }
}

impl<T: Scalar> Sub for Vec2<T> {
    type Output = Vec2<T>;
    fn sub(self, o: Vec2<T>) -> Vec2<T> { Vec2 { x: self.x - o.x, y: self.y - o.y } }
}

impl<T: Scalar> Sub<T> for Vec2<T> {
    type Output = Vec2<T>;
    fn sub(self, s: T) -> Vec2<T> { Vec2 { x: self.x - s, y: self.y - s } }
}

impl<T: Scalar> SubAssign for Vec2<T> {
    fn sub_assign(ref self, o: Vec2<T>) { self = self - o; }
}

impl<T: Scalar> SubAssign<T> for Vec2<T> {
    fn sub_assign(ref self, s: T) { self = self - s; }
}

impl<T: Scalar> Mul for Vec2<T> {
    type Output = Vec2<T>;
    fn mul(self, o: Vec2<T>) -> Vec2<T> { Vec2 { x: self.x * o.x, y: self.y * o.y } }
}

impl<T: Scalar> Mul<T> for Vec2<T> {
    type Output = Vec2<T>;
    fn mul(self, s: T) -> Vec2<T> { Vec2 { x: self.x * s, y: self.y * s } }
}

impl<T: Scalar> MulAssign for Vec2<T> {
    fn mul_assign(ref self, o: Vec2<T>) { self = self * o; }
}

impl<T: Scalar> MulAssign<T> for Vec2<T> {
    fn mul_assign(ref self, s: T) { self = self * s; }
}

impl<T: Scalar> Div for Vec2<T> {
    type Output = Vec2<T>;
    fn div(self, o: Vec2<T>) -> Vec2<T> { Vec2 { x: self.x / o.x, y: self.y / o.y } }
}

impl<T: Scalar> Div<T> for Vec2<T> {
    type Output = Vec2<T>;
    fn div(self, s: T) -> Vec2<T> { Vec2 { x: self.x / s, y: self.y / s } }
}

impl<T: Scalar> DivAssign for Vec2<T> {
    fn div_assign(ref self, o: Vec2<T>) { self = self / o; }
}

impl<T: Scalar> DivAssign<T> for Vec2<T> {
    fn div_assign(ref self, s: T) { self = self / s; }
}

impl<T: Scalar + Neg<Output = T>> Neg for Vec2<T> {
    type Output = Vec2<T>;
    fn neg(self) -> Vec2<T> { Vec2 { x: -self.x, y: -self.y } }
}

impl<T: Scalar> Index<usize> for Vec2<T> {
    type Output = T;
    /// Component `i`: 0 is `x`; past 1 panics.
    #[track_caller]
    fn index(self, i: usize) -> T {
        match i {
            0 => self.x,
            1 => self.y,
            _ => panic(f"Vec2 index {i} is out of range 0..2"),
        }
    }
}

/// `(x, y)`, each component as its `Display`.
impl<T: Scalar> Display for Vec2<T> {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str("(");
        try Display::fmt(self.x, ref f);
        try f.write_str(", ");
        try Display::fmt(self.y, ref f);
        try f.write_str(")")
    }
}

#[impl_macro(vec2_scalar_left)] @macro {
    (@rep[sep = ","] { @t: ty }) => {
        @for @t {
            impl Mul<Vec2<@t>> for @t {
                type Output = Vec2<@t>;
                fn mul(self, v: Vec2<@t>) -> Vec2<@t> { v * self }
            }
        }
    }
}

vec2_scalar_left!(f32, f64, i32, u32);
