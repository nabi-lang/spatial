//! Vectors of 2, 3 and 4 components, and `Vec3A`, a `Vec3` padded to
//! 16 bytes for GPU buffers.

pub(pkg) mod vec2;
pub(pkg) mod vec3;
pub(pkg) mod vec3a;
pub(pkg) mod vec4;

pub use vec2::Vec2;
pub use vec3::Vec3;
pub use vec3a::Vec3A;
pub use vec4::Vec4;

// Constructors with a fixed element type: an unsuffixed literal is f64,
// so `Vec3::new(1.0, 2.0, 3.0)` alone is a `Vec3<f64>`; `vec3(..)` is f32.

/// `Vec2::new(x, y)` with `f32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{Vec2, vec2};
///
/// assert(vec2(1.0, 2.0) == Vec2::<f32>::new(1.0, 2.0));
/// ```
pub const fn vec2(x: f32, y: f32) -> Vec2 { Vec2::new(x, y) }

/// `DVec2::new(x, y)` with `f64` components, whatever the literals.
///
/// ```nabi
/// use spatial::{DVec2, dvec2};
///
/// assert(dvec2(1.0, 2.0) == DVec2::new(1.0, 2.0));
/// ```
pub const fn dvec2(x: f64, y: f64) -> DVec2 { DVec2::new(x, y) }

/// `IVec2::new(x, y)` with `i32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{IVec2, ivec2};
///
/// assert(ivec2(1, -2) == IVec2::new(1, -2));
/// ```
pub const fn ivec2(x: i32, y: i32) -> IVec2 { IVec2::new(x, y) }

/// `UVec2::new(x, y)` with `u32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{UVec2, uvec2};
///
/// assert(uvec2(1, 2) == UVec2::new(1, 2));
/// ```
pub const fn uvec2(x: u32, y: u32) -> UVec2 { UVec2::new(x, y) }

/// `Vec3::new(x, y, z)` with `f32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{Vec3, vec3};
///
/// assert(vec3(1.0, 2.0, 3.0) == Vec3::<f32>::new(1.0, 2.0, 3.0));
/// ```
pub const fn vec3(x: f32, y: f32, z: f32) -> Vec3 { Vec3::new(x, y, z) }

/// `DVec3::new(x, y, z)` with `f64` components, whatever the literals.
///
/// ```nabi
/// use spatial::{DVec3, dvec3};
///
/// assert(dvec3(1.0, 2.0, 3.0) == DVec3::new(1.0, 2.0, 3.0));
/// ```
pub const fn dvec3(x: f64, y: f64, z: f64) -> DVec3 { DVec3::new(x, y, z) }

/// `IVec3::new(x, y, z)` with `i32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{IVec3, ivec3};
///
/// assert(ivec3(1, -2, 3) == IVec3::new(1, -2, 3));
/// ```
pub const fn ivec3(x: i32, y: i32, z: i32) -> IVec3 { IVec3::new(x, y, z) }

/// `UVec3::new(x, y, z)` with `u32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{UVec3, uvec3};
///
/// assert(uvec3(1, 2, 3) == UVec3::new(1, 2, 3));
/// ```
pub const fn uvec3(x: u32, y: u32, z: u32) -> UVec3 { UVec3::new(x, y, z) }

/// `Vec4::new(x, y, z, w)` with `f32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{Vec4, vec4};
///
/// assert(vec4(1.0, 2.0, 3.0, 4.0) == Vec4::<f32>::new(1.0, 2.0, 3.0, 4.0));
/// ```
pub const fn vec4(x: f32, y: f32, z: f32, w: f32) -> Vec4 { Vec4::new(x, y, z, w) }

/// `DVec4::new(x, y, z, w)` with `f64` components, whatever the literals.
///
/// ```nabi
/// use spatial::{DVec4, dvec4};
///
/// assert(dvec4(1.0, 2.0, 3.0, 4.0) == DVec4::new(1.0, 2.0, 3.0, 4.0));
/// ```
pub const fn dvec4(x: f64, y: f64, z: f64, w: f64) -> DVec4 { DVec4::new(x, y, z, w) }

/// `IVec4::new(x, y, z, w)` with `i32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{IVec4, ivec4};
///
/// assert(ivec4(1, -2, 3, 4) == IVec4::new(1, -2, 3, 4));
/// ```
pub const fn ivec4(x: i32, y: i32, z: i32, w: i32) -> IVec4 { IVec4::new(x, y, z, w) }

/// `UVec4::new(x, y, z, w)` with `u32` components, whatever the literals.
///
/// ```nabi
/// use spatial::{UVec4, uvec4};
///
/// assert(uvec4(1, 2, 3, 4) == UVec4::new(1, 2, 3, 4));
/// ```
pub const fn uvec4(x: u32, y: u32, z: u32, w: u32) -> UVec4 { UVec4::new(x, y, z, w) }

/// `Vec2<f64>`.
///
/// ```nabi
/// assert(spatial::DVec2::new(1.0, 2.0).length_squared() == 5.0);
/// ```
pub type DVec2 = Vec2<f64>;

/// `Vec3<f64>`.
///
/// ```nabi
/// assert(spatial::DVec3::X.cross(spatial::DVec3::Y) == spatial::DVec3::Z);
/// ```
pub type DVec3 = Vec3<f64>;

/// `Vec4<f64>`.
///
/// ```nabi
/// assert(spatial::DVec4::ONE.element_sum() == 4.0);
/// ```
pub type DVec4 = Vec4<f64>;

/// `Vec3A<f64>`, 32 bytes.
///
/// ```nabi
/// assert(spatial::DVec3A::size() == 32);
/// ```
pub type DVec3A = Vec3A<f64>;

/// `Vec2<i32>`, a grid position or a pixel size.
///
/// ```nabi
/// assert(spatial::IVec2::new(3, -4).dot(spatial::IVec2::ONE) == -1);
/// ```
pub type IVec2 = Vec2<i32>;

/// `Vec3<i32>`, a voxel or chunk coordinate.
///
/// ```nabi
/// assert(spatial::IVec3::new(1, 2, 3) * 2 == spatial::IVec3::new(2, 4, 6));
/// ```
pub type IVec3 = Vec3<i32>;

/// `Vec4<i32>`.
///
/// ```nabi
/// assert(spatial::IVec4::splat(2).element_product() == 16);
/// ```
pub type IVec4 = Vec4<i32>;

/// `Vec2<u32>`, a texture or window size.
///
/// ```nabi
/// assert(spatial::UVec2::new(1920, 1080).element_product() == 2073600);
/// ```
pub type UVec2 = Vec2<u32>;

/// `Vec3<u32>`, a compute dispatch size.
///
/// ```nabi
/// assert(spatial::UVec3::new(8, 8, 1).element_product() == 64);
/// ```
pub type UVec3 = Vec3<u32>;

/// `Vec4<u32>`, an RGBA8 colour widened, or four indices.
///
/// ```nabi
/// assert(spatial::UVec4::splat(255).max_element() == 255);
/// ```
pub type UVec4 = Vec4<u32>;
